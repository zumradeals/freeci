# FreeCI — modèle de configuration. Aucun secret ici : copier vers .env (jamais committé) et renseigner.
# Valeurs par défaut = DÉVELOPPEMENT. Pour la production, partir de deploy/env.production.example.

# --- Application -------------------------------------------------------------
APP_NAME=FreeCI
APP_ENV=local
# Générée par « php artisan key:generate ». À conserver et sauvegarder : la perdre invalide les sessions et les jetons.
APP_KEY=
APP_DEBUG=true
# Adresse publique COMPLÈTE du site (domaine configurable ici). En production : https://…
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Journaux ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14

# --- Base de données PostgreSQL (≥ 13) -----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=freeci
DB_USERNAME=freeci
DB_PASSWORD=
# DB_SSLMODE=prefer

# --- Sessions, cache, file de tâches (tous en base PostgreSQL : pas de Redis requis) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Laisser « null » : cookie propre à ce domaine, jamais partagé avec d'autres sous-domaines.
SESSION_DOMAIN=null
# En production : true (cookie envoyé seulement en HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX=freeci_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Courrier ------------------------------------------------------------------
# « log » écrit les messages dans storage/logs (développement). En production : smtp, sinon le lien
# « mot de passe oublié » n'est jamais envoyé.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@freeci.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# --- Derrière un proxy / CDN ---------------------------------------------------
# Adresses IP des proxys de confiance, séparées par des virgules (ou « * » si le serveur d'application
# n'est joignable que par le proxy). Vide = accès direct au serveur web.
TRUSTED_PROXIES=

# --- FreeCI : sécurité et démonstration -------------------------------------------
# Durée HSTS en secondes (0 = désactivé). Jamais de « includeSubDomains » : FreeCI n'engage pas le domaine parent.
FREECI_HSTS_MAX_AGE=2592000
# Demande aux moteurs de recherche de ne pas indexer (laisser true tant que la démonstration dure).
FREECI_NOINDEX=true
# Données fictives : JAMAIS installées automatiquement. L'amorçage est refusé en production
# sauf si cette variable vaut true ET qu'on lance volontairement « php artisan db:seed --force ».
FREECI_ALLOW_DEMO_SEED=false
# Mot de passe du compte client de démonstration (vide = généré au hasard et affiché une fois). Ne rien committer.
FREECI_DEMO_CLIENT_PASSWORD=

# Commandes : délais figés dans chaque accord à la demande (heures). Réponse du freelance ; paiement du client
# (le délai de paiement ne court pas tant que le paiement n'est pas ouvert : il n'est pas encore implémenté).
FREECI_RESPONSE_HOURS=48
FREECI_PAYMENT_HOURS=24

# Paiement — Genius Pay est l'UNIQUE passerelle (lot 10.1). Deux modes, choisis EXPLICITEMENT ici, sans bascule automatique :
#   sandbox : commandes de TEST, aucun argent réel (défaut) ; live : argent réel (développé, NON activé tant que les trois conditions ci-dessous ne sont pas réunies).
FREECI_PAYMENT_MODE=sandbox
# Ouvre la création de NOUVEAUX paiements (false = fermé ; le suivi des tentatives existantes continue toujours).
FREECI_PAYMENTS_ENABLED=false
# Autorisation explicite du mode live (false par défaut). Sans elle, mode=live n'ouvre aucun paiement.
FREECI_LIVE_PAYMENTS_AUTHORIZED=false
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
# Jeu SANDBOX (pk_sandbox_… / sk_sandbox_… / whsec_… du bac à sable). Valeurs fournies par Genius Pay : à saisir sur le serveur, JAMAIS dans Git, un navigateur, un journal ou une conversation.
GENIUSPAY_SANDBOX_API_KEY=
GENIUSPAY_SANDBOX_API_SECRET=
GENIUSPAY_SANDBOX_WEBHOOK_SECRET=
GENIUSPAY_SANDBOX_MERCHANT_ID=
# Jeu LIVE (pk_live_… / sk_live_… / whsec_… du mode réel) : à laisser VIDE tant que le live n'est pas activé. L'identifiant du compte marchand est obligatoire en live.
GENIUSPAY_LIVE_API_KEY=
GENIUSPAY_LIVE_API_SECRET=
GENIUSPAY_LIVE_WEBHOOK_SECRET=
GENIUSPAY_LIVE_MERCHANT_ID=

# Conditions financières (lot 11) — PROPOSITIONS DE TRAVAIL, jamais des décisions commerciales approuvées. Le taux est FIGÉ dans chaque accord à sa création :
# le modifier n'affecte aucune commande existante.
FREECI_COMMISSION_BP=1000
FREECI_COMMISSION_POLICY=proposition-non-validee

# Pièces jointes privées du brief. « clamav » exige ClamAV installé (docs/10) ; « none » désactive le dépôt de fichiers.
FREECI_FILE_SCANNER=none
FREECI_CLAMSCAN_BINARY=/usr/bin/clamdscan
FREECI_UPLOAD_MAX_MB=10
# Fichiers d'une livraison : plafond par fichier (Mo). nginx (client_max_body_size) et PHP (upload_max_filesize, post_max_size) doivent l'accepter.
FREECI_DELIVERY_MAX_MB=10
# Livraison : délai d'examen du client (jours ; sans effet automatique) et report d'échéance maximal proposable (jours).
FREECI_REVIEW_DAYS=7
FREECI_EXTENSION_MAX_DAYS=30
# Avis : délai (jours) entre la clôture commerciale et la publication — PROVISOIRE, figé au dépôt de l’avis
FREECI_REVIEW_PUBLICATION_DAYS=14

# Notifications par courriel : n'ont d'effet que si MAIL_MAILER est un pilote RÉEL (pas log/array). Les notifications dans l'application fonctionnent toujours.
FREECI_NOTIFICATION_EMAILS=true
# true = le planificateur (cron schedule:run) vide la file chaque minute ; sinon lancez un processus « queue:work » (deploy/freeci-queue.service.example).
FREECI_QUEUE_VIA_SCHEDULER=false

VITE_APP_NAME="${APP_NAME}"
