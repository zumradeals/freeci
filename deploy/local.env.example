# Réglages propres à CE serveur. Copier vers deploy/local.env (ignoré par Git). Aucun secret ici.
PHP_BIN=php8.3
COMPOSER_BIN="php8.3 /usr/local/bin/composer"
PHP_FPM_SERVICE=php8.3-fpm
BACKUP_DIR=/var/backups/freeci
KEEP_BACKUPS=14
# SKIP_FRONTEND_BUILD=1    # seulement si Node est absent et que public/build est copié à la main
# Copie HORS VPS (facultative ; désactivée tant que rien n'est renseigné). Choisir UNE destination ; la copie est chiffrée (gpg) car elle contient APP_KEY.
# BACKUP_OFFSITE_RCLONE=remote:freeci-backups        # rclone doit être installé et configuré pour l'utilisateur de déploiement
# BACKUP_OFFSITE_RSYNC=utilisateur@hote:/chemin/      # rsync + clé SSH dédiée
# BACKUP_GPG_PASSPHRASE_FILE=/home/freeci/.backup-passphrase   # fichier droits 600 ; NE PAS le sauvegarder au même endroit que les archives
