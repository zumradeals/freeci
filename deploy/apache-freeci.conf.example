# FreeCI — variante Apache (si le serveur utilise Apache au lieu de nginx). Ajouter comme site SÉPARÉ ; ne touche pas aux autres.
# Modules requis : rewrite, ssl, headers, proxy_fcgi (avec PHP-FPM 8.3) ou mod_php 8.3.
<VirtualHost *:80>
    ServerName freeci.dgafrique.com
    DocumentRoot /var/www/freeci/public
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName freeci.dgafrique.com
    DocumentRoot /var/www/freeci/public
    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/freeci.dgafrique.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/freeci.dgafrique.com/privkey.pem
    <Directory /var/www/freeci/public>
        AllowOverride All
        Require all granted
        Options -Indexes
    </Directory>
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.3-fpm.sock|fcgi://localhost"
    </FilesMatch>
    ServerSignature Off
    ErrorLog  ${APACHE_LOG_DIR}/freeci.error.log
    CustomLog ${APACHE_LOG_DIR}/freeci.access.log combined
</VirtualHost>
