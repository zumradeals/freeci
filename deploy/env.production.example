# FreeCI — PRODUCTION. Copier vers /var/www/freeci/.env (droits 640, propriétaire = utilisateur de déploiement,
# groupe = groupe du serveur web). Aucun secret dans ce fichier modèle : remplacer chaque <…>.
APP_NAME=FreeCI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://freeci.dgafrique.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=freeci
DB_USERNAME=freeci
DB_PASSWORD="<mot de passe généré, propre à FreeCI>"
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX=freeci_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST="<serveur SMTP>"
MAIL_PORT=587
MAIL_USERNAME="<identifiant SMTP>"
MAIL_PASSWORD="<mot de passe SMTP>"
MAIL_FROM_ADDRESS="no-reply@<domaine d'envoi autorisé>"
MAIL_FROM_NAME="${APP_NAME}"

# Vide si nginx/Apache reçoit directement le trafic ; sinon IP du proxy / CDN.
TRUSTED_PROXIES=

FREECI_HSTS_MAX_AGE=2592000
FREECI_NOINDEX=true
FREECI_DEMO_BANNER=true
FREECI_ALLOW_DEMO_SEED=false
FREECI_DEMO_CLIENT_PASSWORD=

# Commandes : délais figés dans chaque accord à la demande (heures). Réponse du freelance ; paiement du client
# (le délai de paiement ne court pas tant que le paiement n'est pas ouvert : il n'est pas encore implémenté).
FREECI_RESPONSE_HOURS=48
FREECI_PAYMENT_HOURS=24

# Paiement SIMULÉ : DÉSACTIVÉ par défaut. Même activé, il ne fonctionne que pour des commandes de démonstration et des
# comptes de recette autorisés (jamais pour une commande réelle). Aucun prestataire réel n'est intégré.
FREECI_PAYMENT_SANDBOX=false
# Secret des notifications simulées (HMAC). À générer (openssl rand -hex 32) seulement si le simulateur est activé. Jamais committé.
FREECI_SANDBOX_WEBHOOK_SECRET=

# Pièces jointes privées du brief. « clamav » exige ClamAV installé (docs/10) ; « none » désactive le dépôt de fichiers.
FREECI_FILE_SCANNER=none
FREECI_CLAMSCAN_BINARY=/usr/bin/clamdscan
FREECI_UPLOAD_MAX_MB=10
# Fichiers d'une livraison : plafond par fichier (Mo). nginx (client_max_body_size) et PHP (upload_max_filesize, post_max_size) doivent l'accepter.
FREECI_DELIVERY_MAX_MB=10
# Livraison : délai d'examen du client (jours ; sans effet automatique) et report d'échéance maximal proposable (jours).
FREECI_REVIEW_DAYS=7
FREECI_EXTENSION_MAX_DAYS=30

# Notifications par courriel : n'ont d'effet que si MAIL_MAILER est un pilote RÉEL (pas log/array). Les notifications dans l'application fonctionnent toujours.
FREECI_NOTIFICATION_EMAILS=true
# true = le planificateur (cron schedule:run) vide la file chaque minute ; sinon lancez un processus « queue:work » (deploy/freeci-queue.service.example).
FREECI_QUEUE_VIA_SCHEDULER=false

VITE_APP_NAME="${APP_NAME}"
